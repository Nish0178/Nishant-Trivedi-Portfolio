# ==============================================================================
# Production Environment Configuration Template
# DO NOT commit actual credentials or secrets to this file or version control.
# Copy this file to .env or backend/.env and populate with your own values.
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/portfolio_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (Required in production)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@nishanttrivedi.com
ADMIN_PASSWORD=your_secure_admin_password
JWT_SECRET=your_minimum_256_bit_secure_jwt_signing_secret_key
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# FRONTEND CORS & PUBLIC API
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# PRODUCTION MAIL (Gmail SMTP or Custom SMTP)
# Note: For Gmail, MAIL_PASSWORD must be a 16-character Google App Password
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_TO=trivedinishant880@gmail.com
MAIL_FROM=noreply@nishanttrivedi.com

# ------------------------------------------------------------------------------
# GITHUB SYNCHRONIZATION
# GITHUB_TOKEN is optional (increases rate limit from 60 to 5000 req/hr)
# ------------------------------------------------------------------------------
GITHUB_USERNAME=Nish0178
GITHUB_TOKEN=your_github_personal_access_token_optional
