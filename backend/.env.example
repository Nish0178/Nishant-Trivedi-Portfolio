# PostgreSQL Connection Settings
DB_URL=jdbc:postgresql://localhost:5432/portfolio_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Allowed CORS Frontend Origin
FRONTEND_URL=http://localhost:3000
